watch_file flake.nix flake.lock go.mod web/package.json

# Limit the flake source to its configuration, including before the first commit.
if ! fleet_dev_env="$(
  nix print-dev-env --impure --expr '
    let
      root = toString ./.;
      source = builtins.path {
        path = ./.;
        name = "fleet-flake-source";
        filter = path: _type:
          path == root
          || path == root + "/flake.nix"
          || path == root + "/flake.lock";
      };
      flake = builtins.getFlake (builtins.unsafeDiscardStringContext (toString source));
    in
    flake.devShells.${builtins.currentSystem}.default
  '
)"; then
  unset fleet_dev_env
  return 1
fi
eval "$fleet_dev_env"
unset fleet_dev_env

dotenv_if_exists .env
